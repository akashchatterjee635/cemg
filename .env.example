# -- Neo4j -------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# -- LLM Provider -- set ONE block, leave others blank ------------------
# Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / any OpenAI-compatible endpoint
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1   # or Mistral / Together / Ollama URL

# -- CEMG core tunables --------------------------------------------------
CEMG_LAMBDA=0.03              # default decay constant (days^-1) for successes/unclassified
CEMG_TOP_K=10                 # max experiences returned by /recall
CEMG_FAILURE_BOOST=2.0        # weight multiplier on failed experiences in recall
CEMG_RELEVANCE_WEIGHT=1.5     # how much task-relevance boosts a memory's score
CEMG_FETCH_WINDOW=500         # raw rows pulled from Neo4j before Python-side ranking
CEMG_DEFAULT_NAMESPACE=default  # task namespace used when none is specified
CEMG_MAX_STEPS=15             # max steps per agent session

# -- Pruning / retention --------------------------------------------------
CEMG_PRUNE_FLOOR=0.02          # decay weight below this is eligible for deletion
                               # (only if not under active verification tracking)

# NOTE: failure-class decay constants (transient=0.30, structural=0.01)
# are defined in cemg/classify.py, not here -- they're a core research
# parameter, not an operational tunable, so they're kept in code where
# changes are visible in version control.
